									]
								},
								"url": {
									"type": [
										"number",
										"string"
									],
									"pattern": "[a-zA-z]+:\/\/[^\\s]*",
									"examples": [
										"http:\/\/www.apache.org\/licenses\/LICENSE-2.0.html"
									]
								}
							}
						}
					}
				},
				"host": {
					"type": [
						"number",
						"string"
					],
